// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`--help (dist) > palm --help 1`] = `
"Usage: palm <verb> [kind] [names...] [options]

Package manager for agent resources: skills, agents, instructions, commands,
hooks, MCP servers and plugins.

Verbs:
  install (add, i)                install entities or register an origin
  uninstall (remove, rm, delete)  remove entities or unregister an origin
  get (list, ls)                  list installed entities, origins, targets
  describe (info)                 show one entity, origin or target
  update (up)                     update entities or refresh origin indexes
  create (new)                    create a skill, agent, instruction or command
  search                          search origins and the MCP registry

Utilities:
  init                            create palm.yaml for this project
  doctor                          check git, node, harnesses, drift, origins
  outdated [kind]                 show current, wanted and latest refs
  why <kind> <name>               show why an entity is installed
  find <path>                     show which entity wrote a file
  audit [kind] [names...]         scan installed files for hidden Unicode
  config                          read or change global settings
  completion <shell>              print a shell completion script
  cache                           show or clear the origin cache
  help [command]                  show help for a verb or utility

Options:
  -g, --global                    use the global scope (~), not this project
  -t, --target <ids>              targets: claude,codex,copilot,cursor
  --dry-run                       show what would change; write nothing
  --force                         overwrite files palm does not own
  -y, --yes                       accept defaults instead of prompting
  --offline                       use cached origins only; no network
  --verbose                       debug output and stack traces
  --json                          JSON on stdout; everything else on stderr
  --no-color                      no colours (also NO_COLOR=1)
  -V, --version                   print the palm version
  -h, --help                      display help for command

Kinds: skill (sk), agent (ag), instruction (ins), command (cmd), hook (hk), mcp, plugin (pl),
       origin (orig), target (tg), all. Plurals work too: palm get skills.

Examples:
  palm install origin mattpocock/skills
  palm get skills --available
  palm install skill tdd@mattpocock
  palm describe skill tdd
  palm uninstall skill tdd

Run palm <verb> --help for the forms each verb accepts.
Exit codes: 0 ok, 1 failure, 2 usage error, 130 cancelled, 70 internal error."
`;

exports[`--help (dist) > palm audit --help 1`] = `
"Usage: palm audit [options] [kind] [names...]

Scan the files palm installed for hidden Unicode (bidi overrides, tag
characters, zero-width characters) and for changes since install.

Arguments:
  kind                skill, agent, instruction, command, hook, mcp, plugin
                      (plurals and short names work); omit it for every kind
  names               only these entities

Options:
  --strip             remove the hidden characters from the files
  -h, --help          display help for command

Global Options:
  -g, --global        use the global scope (~), not this project
  -t, --target <ids>  targets: claude,codex,copilot,cursor
  --dry-run           show what would change; write nothing
  --force             overwrite files palm does not own
  -y, --yes           accept defaults instead of prompting
  --offline           use cached origins only; no network
  --verbose           debug output and stack traces
  --json              JSON on stdout; everything else on stderr
  --no-color          no colours (also NO_COLOR=1)
  -V, --version       print the palm version

Without -g the project and the global scope are scanned. Exit 1 while a critical finding
(bidi override, tag character) remains.

Examples:
  palm audit                                scan what palm installed for hidden Unicode
  palm audit skills tdd                     one skill
  palm audit --strip                        remove the hidden characters it finds
  palm audit -g --json                      the global scope only, as JSON"
`;

exports[`--help (dist) > palm cache --help 1`] = `
"Usage: palm cache [options] [command]

Show or clear palm’s cache of origin checkouts and indexes.

Options:
  -h, --help          display help for command

Global Options:
  -g, --global        use the global scope (~), not this project
  -t, --target <ids>  targets: claude,codex,copilot,cursor
  --dry-run           show what would change; write nothing
  --force             overwrite files palm does not own
  -y, --yes           accept defaults instead of prompting
  --offline           use cached origins only; no network
  --verbose           debug output and stack traces
  --json              JSON on stdout; everything else on stderr
  --no-color          no colours (also NO_COLOR=1)
  -V, --version       print the palm version

Commands:
  info                Cache path, size, checkouts and index files.
  clean               Remove every checkout and index (origins stay registered;
                      next use refetches).
  help [command]      display help for command

Examples:
  palm cache info                           where the cache is and how big
  palm cache clean --yes                    remove checkouts and indexes (origins stay)"
`;

exports[`--help (dist) > palm completion --help 1`] = `
"Usage: palm completion [options] <shell>

Print a completion script for bash, zsh or fish, generated from this command
tree.

Arguments:
  shell               bash, zsh or fish

Options:
  -h, --help          display help for command

Global Options:
  -g, --global        use the global scope (~), not this project
  -t, --target <ids>  targets: claude,codex,copilot,cursor
  --dry-run           show what would change; write nothing
  --force             overwrite files palm does not own
  -y, --yes           accept defaults instead of prompting
  --offline           use cached origins only; no network
  --verbose           debug output and stack traces
  --json              JSON on stdout; everything else on stderr
  --no-color          no colours (also NO_COLOR=1)
  -V, --version       print the palm version

Install:
  bash   echo 'source <(palm completion bash)' >> ~/.bashrc
  zsh    echo 'source <(palm completion zsh)' >> ~/.zshrc     (after compinit)
  fish   palm completion fish > ~/.config/fish/completions/palm.fish

Examples:
  palm completion bash
  palm completion zsh > "\${fpath[1]}/_palm""
`;

exports[`--help (dist) > palm config --help 1`] = `
"Usage: palm config [options] [command]

Read or change palm’s global config: targets, mcpRegistryUrl, secrets.project,
secrets.global.

Options:
  -h, --help          display help for command

Global Options:
  -g, --global        use the global scope (~), not this project
  -t, --target <ids>  targets: claude,codex,copilot,cursor
  --dry-run           show what would change; write nothing
  --force             overwrite files palm does not own
  -y, --yes           accept defaults instead of prompting
  --offline           use cached origins only; no network
  --verbose           debug output and stack traces
  --json              JSON on stdout; everything else on stderr
  --no-color          no colours (also NO_COLOR=1)
  -V, --version       print the palm version

Commands:
  get [key]           Print one config value, or all of them.
  set <key> <value>   Set a config value (an empty value unsets it).
  help [command]      display help for command

Examples:
  palm config get
  palm config set targets claude,codex
  palm config set secrets.project literal"
`;

