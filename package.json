{
  "name": "@paliontech/palm",
  "version": "0.0.0",
  "description": "palm — package manager for agent resources: skills, agents, instructions, hooks, MCP servers and plugins, installed into Claude Code, Codex, Copilot and Cursor.",
  "keywords": [
    "agent-skills",
    "claude-code",
    "codex",
    "copilot",
    "cursor",
    "mcp",
    "subagents",
    "package-manager",
    "cli"
  ],
  "homepage": "https://paliontech.github.io/palm",
  "bugs": {
    "url": "https://github.com/PalionTech/palm/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PalionTech/palm.git"
  },
  "license": "MIT",
  "author": "PalionTech / Maximilian Bertram",
  "type": "module",
  "bin": {
    "palm": "./dist/cli.js"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check --linter-enabled=false . && node scripts/lint-ratchet.mjs",
    "lint:fix": "biome check --write .",
    "lint:baseline": "node scripts/lint-ratchet.mjs --update",
    "format": "biome format --write .",
    "check:shape": "node scripts/check-shape.mjs",
    "knip": "knip --no-exit-code",
    "bench": "node scripts/bench-scan.mjs",
    "docs:dev": "npm --prefix docs run dev",
    "docs:build": "npm --prefix docs run build",
    "verify": "npm run lint && npm run typecheck && npm run check:shape && npm run test && npm run build",
    "changeset": "changeset",
    "release": "changeset publish",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@clack/prompts": "^1.0.0",
    "commander": "^14.0.0",
    "execa": "^9.6.0",
    "fast-glob": "^3.3.3",
    "picocolors": "^1.1.1",
    "smol-toml": "^1.4.0",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "~3.2.7",
    "fast-check": "^4.10.2",
    "knip": "^6.38.0",
    "publint": "^0.3.24",
    "tsdown": "^0.23.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "allowScripts": {
    "esbuild@0.27.7": true,
    "esbuild@0.28.2": true
  }
}
