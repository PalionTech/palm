{
  "usage": "palm <verb> [arguments] [options]",
  "globalOptions": [
    {
      "flags": "-g, --global",
      "short": "-g",
      "long": "--global",
      "description": "use ~/.palm/palm.yaml and the harness home directories"
    },
    {
      "flags": "--dry-run",
      "long": "--dry-run",
      "description": "show what would change; write nothing"
    },
    {
      "flags": "--force",
      "long": "--force",
      "description": "replace files you changed or that palm does not own"
    },
    {
      "flags": "-y, --yes",
      "short": "-y",
      "long": "--yes",
      "description": "accept plan confirmations (never consents to programs)"
    },
    {
      "flags": "--allow-exec <list>",
      "long": "--allow-exec",
      "argument": "<list>",
      "description": "allow programs: hook:x@source=sha256:hash,... or all"
    },
    {
      "flags": "--offline",
      "long": "--offline",
      "description": "use the cache only; no network"
    },
    {
      "flags": "--json",
      "long": "--json",
      "description": "one JSON document on stdout; everything else on stderr"
    },
    {
      "flags": "--secrets <policy>",
      "long": "--secrets",
      "argument": "<policy>",
      "description": "env-ref (default) or literal, for secrets you type"
    },
    {
      "flags": "-V, --version",
