    {
      "name": "install",
      "group": "verb",
      "aliases": [
        "add",
        "i"
      ],
      "args": "",
      "summary": "install entities or register an origin",
      "usage": "palm install|add [options] [kind] [names...]",
      "description": "Install entities or register an origin.",
      "arguments": [
        {
          "name": "kind",
          "description": "skill, agent, instruction, command, hook, mcp, plugin, origin (plurals and short names work); omit it to search every entity kind"
        },
        {
          "name": "names",
          "description": "name[@origin][#ref]"
        }
      ],
      "optionGroups": [
        {
          "title": "Options",
          "options": [
            {
              "flags": "--from <origin>",
              "long": "--from",
              "argument": "<origin>",
              "description": "take the entities from this origin spec without registering it"
            },
            {
              "flags": "--save-origin",
              "long": "--save-origin",
              "description": "register the --from origin"
            },
            {
              "flags": "--secrets <policy>",
              "long": "--secrets",
              "argument": "<policy>",
              "description": "MCP secrets: env-ref (project default) or literal (-g default)"
            },
            {
              "flags": "--prune",
              "long": "--prune",
              "description": "no names only: remove installed entries no longer in palm.yaml"
            },
            {
              "flags": "--frozen",
              "long": "--frozen",
              "description": "no names only: install exactly what palm.lock.yaml records; fail on any difference, write nothing"
            },
            {
              "flags": "-h, --help",
              "short": "-h",
              "long": "--help",
              "description": "display help for command"
            }
          ]
        },
        {
          "title": "Ad hoc MCP server options",
          "options": [
            {
              "flags": "--url <url>",
              "long": "--url",
              "argument": "<url>",
              "description": "HTTP/SSE endpoint"
            },
            {
              "flags": "--header <K=V>",
              "long": "--header",
              "argument": "<K=V>",
              "description": "HTTP header (repeatable)"
            },
            {
              "flags": "--env <K=V>",
              "long": "--env",
              "argument": "<K=V>",
              "description": "environment variable (repeatable)"
            },
            {
              "flags": "--transport <t>",
              "long": "--transport",
              "argument": "<t>",
              "description": "stdio, http or sse"
            }
          ]
        },
        {
          "title": "Origin options (install origin)",
          "options": [
            {
              "flags": "--alias <alias>",
              "long": "--alias",
              "argument": "<alias>",
              "description": "short name used in name@alias (default: repo name)"
            },
            {
              "flags": "--ref <ref>",
              "long": "--ref",
              "argument": "<ref>",
              "description": "tag, branch or sha (default: latest semver tag, else default branch)"
            },
            {
              "flags": "--root <path>",
              "long": "--root",
              "argument": "<path>",
              "description": "subdirectory that is the origin root"
            },
            {
              "flags": "--layout <kind=glob>",
              "long": "--layout",
              "argument": "<kind=glob>",
              "description": "layout descriptor instead of auto-detection, e.g. skills='skills/.curated/*' (repeatable; kinds: skills, agents, commands, instructions, hooks, mcp, exclude, include; or nameFrom=dirname)"
            },
            {
              "flags": "--project",
              "long": "--project",
              "description": "save the origin in this project’s palm.yaml instead of the global config"
            }
          ]
        }
