      "flags": "--dry-run",
      "long": "--dry-run",
      "description": "show what would change; write nothing"
    },
    {
      "flags": "--force",
      "long": "--force",
      "description": "overwrite files palm does not own"
    },
    {
      "flags": "-y, --yes",
      "short": "-y",
      "long": "--yes",
      "description": "accept defaults instead of prompting"
    },
    {
      "flags": "--offline",
      "long": "--offline",
