---
// Custom 404 page. Starlight's default 404 route is disabled in astro.config.mjs
// (disable404Route), because a 404.md docs entry collides with the catch-all docs route.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<StarlightPage
  frontmatter={{
    title: 'Page not found',
    description: 'This page does not exist. Start from the docs overview or search.',
    template: 'splash',
    editUrl: false,
    lastUpdated: false,
    pagefind: false,
  }}
>
  <p>This page does not exist, or it moved.</p>
  <ul>
    <li>Start from <a href={`${base}/getting-started/`}>What is palm</a>.</li>
    <li>Search the docs with the search box at the top.</li>
    <li>
      Report a broken link in the <a href="https://github.com/PalionTech/palm/issues">issue tracker</a>.
    </li>
  </ul>
</StarlightPage>
