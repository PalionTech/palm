{
  "name": "@paliontech/palm-docs",
  "version": "0.0.0",
  "private": true,
  "description": "Documentation site and landing page for palm (Astro Starlight).",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "sync:brand": "node scripts/sync-brand.mjs",
    "check:copy": "node scripts/check-copy.mjs",
    "dev": "node scripts/sync-brand.mjs && astro dev",
    "build": "node scripts/sync-brand.mjs && node scripts/check-copy.mjs && astro build",
    "preview": "astro preview",
    "capture": "node scripts/capture.mjs",
    "capture:check": "node scripts/capture.mjs --check",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/starlight": "0.42.4",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "astro": "7.3.5",
    "sharp": "0.35.5",
    "starlight-links-validator": "0.26.0",
    "starlight-llms-txt": "0.12.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents": false
  }
}
